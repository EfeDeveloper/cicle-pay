rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(data) {
      return data.userId == request.auth.uid;
    }

    function isPathOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidStatus(status) {
      return status in ['pending', 'paid'];
    }

    function isValidSource(source) {
      return source in ['template', 'manual'];
    }

    function isValidPeriodKey(periodKey) {
      return periodKey is string && periodKey.matches('^\\d{4}-(0[1-9]|1[0-2])$');
    }

    function isValidAmount(amount) {
      return amount is number && amount > 0;
    }

    function isValidDescription(data) {
      return !('description' in data)
        || (data.description is string && data.description.size() <= 140);
    }

    function isValidDueDay(data) {
      return !('dueDay' in data)
        || data.dueDay == null
        || (data.dueDay is int && data.dueDay >= 1 && data.dueDay <= 31);
    }

    function isValidMonthlyExpense(data, periodKey) {
      return isValidStatus(data.status)
        && isValidSource(data.source)
        && isValidPeriodKey(data.periodKey)
        && data.periodKey == periodKey
        && isValidAmount(data.amount)
        && isValidDescription(data)
        && isValidDueDay(data)
        && (
          (data.source == 'manual' && data.templateId == null)
          || (data.source == 'template' && data.templateId is string)
        );
    }

    function isValidExpenseTemplate(data) {
      return isValidAmount(data.amount)
        && isValidDescription(data)
        && isValidDueDay(data);
    }

    function isPositiveCap(value) {
      return (value is int || value is float) && value > 0;
    }

    function capOk(cats, name) {
      return !(name in cats) || isPositiveCap(cats.get(name, 0));
    }

    function isValidCategoryCaps(data) {
      return !('categories' in data)
        || (
          data.categories is map
          && data.categories.size() > 0
          && data.categories.keys().hasOnly([
            'Vivienda',
            'Servicios',
            'Alimentación',
            'Transporte',
            'Salud',
            'Educación',
            'Entretenimiento',
            'Seguros',
            'Suscripciones',
            'Otros'
          ])
          && capOk(data.categories, 'Vivienda')
          && capOk(data.categories, 'Servicios')
          && capOk(data.categories, 'Alimentación')
          && capOk(data.categories, 'Transporte')
          && capOk(data.categories, 'Salud')
          && capOk(data.categories, 'Educación')
          && capOk(data.categories, 'Entretenimiento')
          && capOk(data.categories, 'Seguros')
          && capOk(data.categories, 'Suscripciones')
          && capOk(data.categories, 'Otros')
        );
    }

    function isValidBudget(data, periodKey) {
      return isOwner(data)
        && data.periodKey == periodKey
        && isValidPeriodKey(data.periodKey)
        && isValidAmount(data.totalAmount)
        && isValidCategoryCaps(data);
    }

    match /payment_cycles/{userId} {
      allow read, write: if false;

      match /templates/{templateId} {
        allow read: if isPathOwner(userId);
        allow create: if isPathOwner(userId)
          && isOwner(request.resource.data)
          && isValidExpenseTemplate(request.resource.data);
        allow update: if isPathOwner(userId)
          && isOwner(resource.data)
          && isOwner(request.resource.data)
          && isValidExpenseTemplate(request.resource.data);
        allow delete: if isPathOwner(userId);
      }

      match /expenses/{periodKey} {
        allow read: if isPathOwner(userId);
        allow create, update, delete: if false;

        match /items/{expenseId} {
        allow read: if isPathOwner(userId);
        allow create: if isPathOwner(userId)
          && isOwner(request.resource.data)
          && isValidMonthlyExpense(request.resource.data, periodKey);
        allow update: if isPathOwner(userId)
          && isOwner(resource.data)
          && isOwner(request.resource.data)
          && isValidMonthlyExpense(request.resource.data, periodKey);
        allow delete: if isPathOwner(userId);
        }
      }

      match /budgets/{periodKey} {
        allow read: if isPathOwner(userId);
        allow create: if isPathOwner(userId)
          && isValidBudget(request.resource.data, periodKey);
        allow update: if isPathOwner(userId)
          && isOwner(resource.data)
          && isValidBudget(request.resource.data, periodKey);
        allow delete: if isPathOwner(userId)
          && isOwner(resource.data);
      }
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /expense_templates/{templateId} {
      allow read, write: if false;
    }

    match /monthly_expenses/{expenseId} {
      allow read, write: if false;
    }
  }
}
